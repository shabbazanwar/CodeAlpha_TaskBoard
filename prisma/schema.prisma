// Prisma schema for CodeAlpha_TaskBoard
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection used by `prisma migrate` — migrations cannot run
  // through the transaction pooler.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
