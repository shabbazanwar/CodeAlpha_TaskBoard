# Neon Postgres connection strings.
# Neon console -> your project -> Connect -> choose "Prisma" for both values.

# Pooled connection (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require&pgbouncer=true&connect_timeout=15"

# Direct connection (same host without "-pooler"), used by prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Secret used to sign NextAuth session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"
