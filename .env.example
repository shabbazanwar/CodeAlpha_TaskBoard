# Supabase Postgres connection string (Session pooler or direct connection).
# Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?schema=public"

# Secret used to sign NextAuth session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"
